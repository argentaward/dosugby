# Окружение: local | production
APP_ENV=local

# SQLite локально. Для PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dosug
DATABASE_URL=sqlite+aiosqlite:///./dosug.db

# Откуда разрешены запросы фронтенда (через запятую)
CORS_ORIGINS=http://localhost:5173

# Доступ к /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-to-random-string
